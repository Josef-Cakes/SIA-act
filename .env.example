# Copy to .env for local development. This file contains placeholders only.
# Never commit the real .env file or production credentials.

APP_NAME=auth-backend
APP_ENV=local
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Supabase/PostgreSQL. Use the Supabase transaction pooler (port 6543) for
# hosted deployments and keep sslmode=require in the JDBC URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/farmville
DB_USER=farmville_app
DB_PASSWORD=replace-with-environment-specific-password
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_CONNECTION_INIT_SQL=SET bytea_output = 'escape'

# Flyway owns schema changes. Do not use update against a real farm database.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=3

# Generate a unique secret per environment (at least 32 bytes for HS256).
JWT_SECRET=replace-with-at-least-32-bytes-jwt-secret
JWT_EXPIRATION_MS=86400000

# CORS and uploads
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=5MB

# Optional local-only bootstrap admin. Keep disabled in staging/production.
APP_DEFAULT_ADMIN_ENABLED=false
APP_DEFAULT_ADMIN_USERNAME=local_admin
APP_DEFAULT_ADMIN_EMAIL=admin@example.local
APP_DEFAULT_ADMIN_PASSWORD=replace-with-local-only-password

# Logging
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=INFO

# Frontend development (if the frontend is run from this repository)
VITE_API_ORIGIN=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api
VITE_DEV_SERVER_PORT=5173
